<Window x:Class="pr34_Markova.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pr34_Markova"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="#E0E0E0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>
        <Border
            Grid.Row="0"
            Background="Gray"
            Margin="20"
            ClipToBounds="True">
            <Grid>
                <Image
                    x:Name="MainImage"
                    Source="Images\portrait.png"
                    Stretch="Uniform"/>
                <Canvas x:Name="SelectionCanvas">
                    <Rectangle
                        x:Name="SelectionRect"
                        Stroke="DeepSkyBlue"
                        StrokeThickness="2"
                        Fill="#3300BFFF"
                        Visibility="Collapsed"/>
                </Canvas>
            </Grid>
        </Border>
        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="0,15,0,0">
            <Button
                x:Name="ClearButton"
                Content="ОЧИСТИТЬ"
                Width="150"
                Height="45"
                Margin="10"
                Background="#F57C00"
                Foreground="White"
                FontSize="20"
                Click="ClearButton_Click"/>
            <Button
                x:Name="CropButton"
                Content="ОБРЕЗАТЬ"
                Width="150"
                Height="45"
                Margin="10"
                Background="#43A047"
                Foreground="White"
                FontSize="20"
                Click="CropButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
